# po/meson.build — i18n.gettext() reads POTFILES.in (relative to this
# directory) and LINGUAS from here, builds one .mo per language listed in
# LINGUAS, and installs it under <prefix>/<localedir>. Source strings are
# English; translations live in this directory as one <lang>.po per
# language (currently just es.po).
i18n.gettext(
  gettext_package,
  preset: 'glib',
  install: true,
)
